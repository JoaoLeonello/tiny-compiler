int main() {
    print(2 + 3 * 4);
    print((2 + 3) * 4);
    print(20 - 4 - 3);
    print(-7 / 2);
    print(-7 % 2);
    print(100 / 7 % 4);
    print(-(-5));
    int x = 10;
    int y = x * 2 + 1;
    print(y);
    if (1 + 1 == 2 && !(3 > 4)) print(1); else print(0);
    print(9223372036854775807 + 1);
    return 0;
}
